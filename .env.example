# ==============================================================================
# RepoArchaeology - Configuración de Variables de Entorno
# ==============================================================================

# Proveedor de Inteligencia Artificial (Opciones: local, gemini, openai, offline)
# En modo 'offline' el sistema funciona 100% con análisis heurístico y estadístico de Git.
AI_PROVIDER=offline

# Claves de API para proveedores en la nube (Opcional - solo si AI_PROVIDER=gemini u openai)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Configuración de Modelo Local (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Seguridad y Rendimiento
MAX_COMMITS_SCAN=500
ANALYZE_MAX_FILE_SIZE_KB=1024
EXCLUDE_DIRS=node_modules,.git,dist,build,.venv,__pycache__,vendor
